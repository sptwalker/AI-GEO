# ===== 应用 =====
APP_SECRET=please-change-this-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=please-change-me
RUN_SCHEDULER=false           # M2 定时调度开关，M1 暂用不到

# ===== 数据库 (docker-compose 中 DB_HOST=mysql) =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ai_geo
DB_PASSWORD=ai_geo_pwd
DB_NAME=ai_geo

# ===== 判定裁判 =====
JUDGE_MODEL_KEY=deepseek
CORRECTNESS_THRESHOLD=60

# ===== 采集并发 =====
ASK_CONCURRENCY=6
ASK_TIMEOUT=60
ASK_MAX_RETRIES=2

# ===== 各模型密钥（按需配置；未配置的模型自动停用）=====
# 变量名需与 llm_model.api_key_env 对应，registry 启动时按此读取
DEEPSEEK_API_KEY=
KIMI_API_KEY=
TONGYI_API_KEY=
DOUBAO_API_KEY=
WENXIN_API_KEY=
XINGHUO_API_KEY=

# ===== 报警（M2 使用）=====
ALERT_WEBHOOK_URL=            # 飞书群机器人 Webhook
