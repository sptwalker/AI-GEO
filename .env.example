# ===== 应用 =====
APP_SECRET=please-change-this-random-secret
ADMIN_USERNAME=admin          # 首次启动据此播种初始管理员用户
ADMIN_PASSWORD=please-change-me
RUN_SCHEDULER=false           # true=应用内嵌定时调度（单进程部署时开启）
SCHEDULER_TIMEZONE=Asia/Shanghai
AUTO_CREATE_TABLES=true       # true=启动自动建表(开发便捷)；false=交给 Alembic 迁移(生产)

# ===== 数据库 (docker-compose 中 DB_HOST=mysql) =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ai_geo
DB_PASSWORD=ai_geo_pwd
DB_NAME=ai_geo

# ===== 判定（M5 智能校验）=====
JUDGE_MODEL_KEY=deepseek
CORRECTNESS_THRESHOLD=60      # 正确性低于此分风险至少中度
JUDGE_VOTES=3                 # 多裁判投票次数，降误判/漏判
DEFAULT_SAMPLES=1             # 一致性采样次数默认(1=关闭)；手动批次可覆盖
ALERT_RISK_THRESHOLD=moderate # 达到此风险级(含)即中高危告警：moderate/severe

# ===== 报警（M5 多渠道）=====
ALERT_WEBHOOK_URL=            # 飞书自定义群机器人 Webhook
ALERT_WEBHOOK_SECRET=        # 可选：飞书加签密钥
WECOM_WEBHOOK_URL=           # 企业微信群机器人 Webhook
SMTP_HOST=                   # 邮件告警(留空则不启用)
SMTP_PORT=465               # 465=SSL / 587=STARTTLS
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_MAIL_TO=              # 收件人，逗号分隔

# ===== 采集并发 =====
ASK_CONCURRENCY=6
ASK_TIMEOUT=60
ASK_MAX_RETRIES=2

# ===== 各模型密钥（按需配置；未配置的模型自动停用）=====
# 变量名需与 llm_model.api_key_env 对应，registry 启动时按此读取
DEEPSEEK_API_KEY=
KIMI_API_KEY=
TONGYI_API_KEY=
DOUBAO_API_KEY=
WENXIN_API_KEY=
XINGHUO_API_KEY=
