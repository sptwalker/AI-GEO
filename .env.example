# ===== 应用 =====
APP_SECRET=please-change-this-random-secret
ADMIN_USERNAME=admin          # 首次启动据此播种初始管理员用户
ADMIN_PASSWORD=please-change-me
RUN_SCHEDULER=false           # true=应用内嵌定时调度（单进程部署时开启）
SCHEDULER_TIMEZONE=Asia/Shanghai
AUTO_CREATE_TABLES=true       # true=启动自动建表(开发便捷)；false=交给 Alembic 迁移(生产)

# ===== 数据库 (docker-compose 中 DB_HOST=mysql) =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ai_geo
DB_PASSWORD=ai_geo_pwd
DB_NAME=ai_geo

# ===== 判定裁判 =====
JUDGE_MODEL_KEY=deepseek
CORRECTNESS_THRESHOLD=60

# ===== 采集并发 =====
ASK_CONCURRENCY=6
ASK_TIMEOUT=60
ASK_MAX_RETRIES=2

# ===== 各模型密钥（按需配置；未配置的模型自动停用）=====
# 变量名需与 llm_model.api_key_env 对应，registry 启动时按此读取
DEEPSEEK_API_KEY=
KIMI_API_KEY=
TONGYI_API_KEY=
DOUBAO_API_KEY=
WENXIN_API_KEY=
XINGHUO_API_KEY=

# ===== 报警（M2）=====
ALERT_WEBHOOK_URL=            # 飞书自定义群机器人 Webhook
ALERT_WEBHOOK_SECRET=        # 可选：机器人"加签"密钥（开启加签时填）
